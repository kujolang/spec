# Spec Validator — validates spec JSON against the schema.
# Called as: kujo run src/validate.kujo --json <tmp-file> [--format yaml|toml|json]
# Outputs JSON: {"valid": true/false, "errors": [...], "warnings": [...]}

from src.common import dict_get, dict_get_arr

KNOWN_CHECK_TYPES := [
	"command_succeeds", "command_output_contains", "file_exists",
	"file_contains", "file_line_count", "json_path_value",
	"snapshot_matches", "directory_contains_files", "regex_matches",
	"command_timing_less_than", "env_var_set", "http_status",
	"http_body_contains", "markdown_contains_section", "exit_code",
	"stdout_contains", "stderr_empty", "artifact_exists"
]

VALID_PRIORITIES := ["critical", "high", "medium", "low"]
VALID_SEVERITIES := ["low", "medium", "high", "critical"]
KNOWN_TOP_LEVEL_FIELDS := [
	"name", "goal", "id", "status", "version", "created_at",
	"background", "scope", "non_goals", "relevant_systems", "likely_files",
	"acceptance_criteria", "eval_requirements", "risks", "dependencies",
	"review_expectations", "human_approval_points", "estimated_effort",
	"priority", "assignee", "tags", "parent_id"
]

func is_known_check_type(ct) {
	i := 0
	while i < len(KNOWN_CHECK_TYPES) {
		if KNOWN_CHECK_TYPES[i] == ct { return true }
		i := i + 1
	}
	return false
}

func is_valid_priority(p) {
	i := 0
	while i < len(VALID_PRIORITIES) {
		if VALID_PRIORITIES[i] == p { return true }
		i := i + 1
	}
	return false
}

func is_valid_severity(s) {
	i := 0
	while i < len(VALID_SEVERITIES) {
		if VALID_SEVERITIES[i] == s { return true }
		i := i + 1
	}
	return false
}

func is_known_top_level_field(k) {
	i := 0
	while i < len(KNOWN_TOP_LEVEL_FIELDS) {
		if KNOWN_TOP_LEVEL_FIELDS[i] == k { return true }
		i := i + 1
	}
	return false
}

export func validate_spec(spec) {
	errors := []
	warnings := []

	# Required fields
	name := dict_get(spec, "name", "")
	if name == "" { errors := push(errors, "Missing required field: name") }
	if len(name) > 200 { errors := push(errors, "Field name exceeds 200 characters") }

	goal := dict_get(spec, "goal", "")
	if goal == "" { errors := push(errors, "Missing required field: goal") }
	if len(goal) > 5000 { errors := push(errors, "Field goal exceeds 5000 characters") }

	# String fields
	_check_str(spec, "version", errors, false)
	_check_str(spec, "background", errors, false)
	_check_str(spec, "scope", errors, false)
	_check_str(spec, "estimated_effort", errors, false)
	_check_str(spec, "assignee", errors, false)

	# Array of strings
	_check_str_array(spec, "non_goals", errors, 200)
	_check_str_array(spec, "relevant_systems", errors, 50)
	_check_str_array(spec, "likely_files", errors, 200)
	_check_str_array(spec, "acceptance_criteria", errors, 100)
	_check_str_array(spec, "dependencies", errors, 100)
	_check_str_array(spec, "review_expectations", errors, 50)
	_check_str_array(spec, "human_approval_points", errors, 50)
	_check_str_array(spec, "tags", errors, 50)

	# Eval requirements
	_check_eval_requirements(spec, errors, warnings)

	# Risks
	_check_risks(spec, errors, warnings)

	# Priority
	priority := dict_get(spec, "priority", "medium")
	if is_valid_priority(priority) == false { errors := push(errors, "Invalid priority: " + priority + " (use critical/high/medium/low)") }

	# Top-level unknown field lint gate (warning in default mode; error in strict mode).
	_check_unknown_top_level_fields(spec, warnings)

	return {
		"valid": len(errors) == 0,
		"errors": errors,
		"warnings": warnings
	}
}

func _check_unknown_top_level_fields(spec, warnings) {
	keys_arr := keys(spec)
	i := 0
	while i < len(keys_arr) {
		k := keys_arr[i]
		if is_known_top_level_field(k) == false {
			warnings := push(warnings, "Unknown top-level field: " + k)
		}
		i := i + 1
	}
}

func _check_str(spec, key, errors, required) {
	has_entry := has_key(spec, key)
	if has_entry == false || has_entry == 0 {
		if required == true { errors := push(errors, "Missing required field: " + key) }
		return
	}
	v := spec[key]
	# Validate that v is a string by attempting string concatenation
	is_str := false
	try { tmp := v + ""; is_str := true } except err {}
	if is_str == false { errors := push(errors, "Field " + key + " must be a string, got non-string value") }
}

func _check_str_array(spec, key, errors, max_items) {
	arr := dict_get(spec, key, [])
	has_arr := has_key(spec, key)
	if has_arr == false || has_arr == 0 { return }
	count := len(arr)
	if count > max_items { errors := push(errors, "Field " + key + " exceeds maximum of " + to_string(max_items) + " items") }
}

func _check_eval_requirements(spec, errors, warnings) {
	has_er := has_key(spec, "eval_requirements")
	if has_er == false || has_er == 0 { return }
	arr := spec["eval_requirements"]
	count := len(arr)
	if count > 200 { errors := push(errors, "Field eval_requirements exceeds 200 items") }
	i := 0
	while i < count {
		er := arr[i]
		has_desc := has_key(er, "description")
		if has_desc == false || has_desc == 0 { errors := push(errors, "eval_requirements[" + to_string(i) + "] missing description") }
		has_ct := has_key(er, "check_type")
		if has_ct == true || has_ct == 1 {
			ct := er["check_type"]
			if ct != "" && is_known_check_type(ct) == false { warnings := push(warnings, "Unknown check_type: " + ct) }
		}
		i := i + 1
	}
}

func _check_risks(spec, errors, warnings) {
	has_r := has_key(spec, "risks")
	if has_r == false || has_r == 0 { return }
	arr := spec["risks"]
	count := len(arr)
	if count > 100 { errors := push(errors, "Field risks exceeds 100 items") }
	i := 0
	while i < count {
		r := arr[i]
		has_risk := has_key(r, "risk")
		if has_risk == false || has_risk == 0 { errors := push(errors, "risks[" + to_string(i) + "] missing risk field") }
		has_sev := has_key(r, "severity")
		if has_sev == true || has_sev == 1 {
			sev := r["severity"]
			if is_valid_severity(sev) == false { warnings := push(warnings, "Invalid severity: " + sev) }
		}
		i := i + 1
	}
}

func print_invalid_result(message) {
	print("{\"valid\": false, \"errors\": [\"" + message + "\"]}")
}

#
# Main: read spec JSON file and validate
#
func main() {
	parser := arg_parser()
	parser := parser.add_argument("--json", "type", "string", "default", "", "help", "Path to parsed spec JSON")
	parsed_args := parser.parse()
	json_file := trim(to_string(parsed_args["json"]))

	if json_file == "" {
		print_invalid_result("No --json <file> argument provided")
		return
	}

	raw := ""
	try { raw = read_file(json_file) } except err {
		print_invalid_result("Cannot read file: " + json_file)
		return
	}

	spec := {}
	try { spec = parse_json(raw) } except err {
		print_invalid_result("JSON parse error")
		return
	}

	result := validate_spec(spec)
	print(to_json(result))
}

main()
